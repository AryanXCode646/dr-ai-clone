{
    "name": "dr-ai",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "@emotion/react": "^11.11.3",
        "@emotion/styled": "^11.11.0",
        "@headlessui/react": "^2.2.0",
        "@heroicons/react": "^2.2.0",
        "@mui/icons-material": "^5.15.10",
        "@mui/material": "^5.15.10",
        "@testing-library/jest-dom": "^5.17.0",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^13.5.0",
        "@types/canvas-confetti": "^1.9.0",
        "@types/jest": "^27.5.2",
        "@types/node": "^16.18.80",
        "@types/react": "^18.2.55",
        "@types/react-dom": "^18.2.19",
        "axios": "^1.8.4",
        "canvas-confetti": "^1.9.2",
        "framer-motion": "^11.0.3",
        "jspdf": "^2.5.1",
        "lucide-react": "^0.359.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.30.0",
        "react-scripts": "5.0.1",
        "typescript": "^4.9.5",
        "web-vitals": "^2.1.4"
    },
    "homepage": "https://aryanxcode646.github.io/dr-ai-clone",
    "scripts": {
        "install:all": "npm install --legacy-peer-deps && npm install --prefix dr-ai-backend --legacy-peer-deps",
        "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run server\" \"npm run client\"",
        "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run server\" \"npm run client\"",
        "client": "react-scripts start",
        "server": "npm run dev --prefix dr-ai-backend",
        "build": "react-scripts build",
        "build:backend": "npm run build --prefix dr-ai-backend",
        "build:all": "npm run build && npm run build:backend",
        "test": "react-scripts test",
        "test:backend": "npm test --prefix dr-ai-backend",
        "test:all": "CI=true npm test -- --watchAll=false && npm run test:backend",
        "eject": "react-scripts eject",
        "deploy:docs": "git subtree push --prefix docs origin gh-pages"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "concurrently": "^10.0.5"
    }
}
