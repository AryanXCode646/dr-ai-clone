# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/dr-ai

# Security & Authentication (MUST be set in production, min 32 chars)
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production

# AI Provider (Optional: if omitted, system runs in explicit Demo AI mode)
OPENAI_API_KEY=

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Demo Mode (Explicit opt-in for demo data and test accounts)
DEMO_MODE=true
